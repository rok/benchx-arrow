# Copy to node/node.env (git-ignored) and edit. Sourced by node/bench-node.sh,
# node/check-node.sh and provider/arrow-provider.sh. Settings shared by every
# node (the project, the upstream) live in project.json instead.

# The name this node's runs are filed under: runs/<sha>/<NODE_NAME>/.
# A replacement machine is a new node, even under the old name; pick a new one.
NODE_NAME=$(hostname -s)

# Everything the node builds and caches lives here, outside the repository.
# The default is ~/.benchx-<name in project.json>, one per project.
#BENCHX_WORK=$HOME/.benchx-arrow

# The benchx command. The default is a venv under the work directory:
#   uv venv ~/.benchx-arrow/venv && uv pip install --python ~/.benchx-arrow/venv/bin/python \
#       -e /path/to/benchx/prototype
#BX=$HOME/.benchx-arrow/venv/bin/bx

# The upstream repository and branch come from project.json; override them here
# only for this node (a mirror, say). UPSTREAM_REFERENCE is an optional local
# clone to borrow objects from on the first clone (saves a gigabyte for Arrow).
#UPSTREAM_URL=https://github.com/apache/arrow.git
#UPSTREAM_BRANCH=main
#UPSTREAM_REFERENCE=$HOME/src/arrow

# Which benchmark binaries to run: a regex over names like arrow-array-benchmark.
SUITE_FILTER=.
# How many commits back on main the node looks for one it has not measured.
LOOKBACK=50
# Precision and limits, per Google Benchmark case.
REPETITIONS=3
CASE_TIMEOUT=600
# Parallelism of the build.
BUILD_JOBS=$(nproc)
# 0 keeps everything local: no pull before, no commit or push after a run.
GIT_PUSH=1
