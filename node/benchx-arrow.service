[Unit]
Description=benchx node for @PROJECT@: measure one upstream commit
After=network-online.target

[Service]
Type=oneshot
# node/install-units.sh replaces @ROOT@ with the repository's path on this node.
ExecStart=@ROOT@/node/bench-node.sh
# One tick can take an hour or more (an Arrow build, then every benchmark binary).
TimeoutStartSec=12h
